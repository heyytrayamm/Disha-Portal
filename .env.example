# System Settings
PROJECT_NAME="AI-Powered Label Compliance Checking System"
VERSION="2026.1.0"
SECRET_KEY="super-secret-sih2026-compliance-key-change-in-production"

# Database Configuration (PostgreSQL / SQLite)
DATABASE_URL="sqlite:///./label_compliance.db"
# DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/sih_compliance_db"

# AWS S3 Storage (Optional - uses local fallback if unconfigured)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
S3_BUCKET_NAME=""

# Backend Port & CORS (Railway uses dynamic $PORT)
PORT=8000
ALLOWED_ORIGINS="*"

# Gemini AI Integration (Backend only - NEVER expose to frontend)
GEMINI_API_KEY="your-gemini-api-key-here"

# Frontend API URL (Set to deployed Railway backend in production)
VITE_API_URL="http://127.0.0.1:8000"
# In production on Vercel/Netlify/Railway:
# VITE_API_URL="https://disha-portal-production.up.railway.app"

